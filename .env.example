# ─── OKX Market Data (public API, no auth needed) ───────
OKX_INST_ID=BTC-USDT
OKX_BAR=1H
OKX_CANDLE_LIMIT=2000

# ─── OKX Trading (required for live/demo execution) ─────
# Get API keys: https://www.okx.com/account/my-api
# Use sub-account API keys for safety!
# NOTE: demo & live use DIFFERENT API keys.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Set to false for live trading (requires live API key)
OKX_DEMO=true

# ─── Training ───────────────────────────────────────────
BATCH_SIZE=8192
TRAIN_STEPS=500
MAX_FORMULA_LEN=12
LEARNING_RATE=0.001

# ─── Backtest / Trading ─────────────────────────────────
BASE_FEE=0.001          # OKX spot VIP0 taker fee: 0.1%
TRADE_SIZE_USD=1000.0
SIGNAL_THRESHOLD=0.5

# ─── Output ─────────────────────────────────────────────
SAVE_DIR=./output
